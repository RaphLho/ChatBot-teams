# Clé API Mistral AI
MISTRAL_API_KEY=votre_cle_api_ici

# Identifiants Microsoft Bot Framework
# Ces mêmes identifiants sont réutilisés pour le SSO de connexion à la page chatbot
# (flux Authorization Code en plus du flux Client Credentials déjà utilisé pour Graph).
MICROSOFT_APP_ID=votre_app_id
MICROSOFT_APP_PASSWORD=votre_app_password
MICROSOFT_APP_TENANT_ID=votre_tenant_id

# SSO Microsoft pour l'accès à la page chatbot
# Laisser VIDE (ou commenté) : l'URL de retour est alors déduite automatiquement du domaine
# appelé par le navigateur (http://localhost:3978/auth/callback en local,
# https://bot-teams.campus-pays-de-la-loire.fr/auth/callback en production).
# Ne renseigner cette variable que pour forcer une URL précise.
# ATTENTION : ne jamais laisser une valeur "localhost" sur le serveur de production,
# sinon Microsoft renvoie l'utilisateur vers localhost (ERR_CONNECTION_REFUSED).
SSO_REDIRECT_URI=
# Domaines email autorisés à se connecter, par rôle (séparés par des virgules si plusieurs).
# Le rôle déduit du domaine remplace le sélecteur manuel Étudiant/Collaborateur de l'interface.
STUDENT_EMAIL_DOMAINS=campus-espl.fr
COLLABORATOR_EMAIL_DOMAINS=groupe-eduservices.fr

# Connexions aux bases de données locales (services via docker-compose)
REDIS_URL=redis://redis:6379
CHROMA_URL=http://chromadb:8000

# Serveur et Port par défaut pour Express
PORT=3978

# Authentification page de statistiques
ID_STATS=identifiant_admin
MDP_STATS=mot_de_passe_admin
SESSION_SECRET=une_chaine_aleatoire_longue_a_generer
